{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "iam:CreateRole",
      "Resource": "arn:aws:iam::412930559924:role/lesson-7-eks-jenkins-agent",
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::412930559924:policy/lesson-7-eks-jenkins-agent-ecr",
          "aws:RequestTag/Project": "goit-dev-ops-hw-04"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:ListInstanceProfilesForRole",
        "iam:DeleteRole",
        "iam:TagRole",
        "iam:UntagRole"
      ],
      "Resource": "arn:aws:iam::412930559924:role/lesson-7-eks-jenkins-agent"
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": "arn:aws:iam::412930559924:role/lesson-7-eks-jenkins-agent",
      "Condition": {
        "ArnEquals": {
          "iam:PolicyARN": "arn:aws:iam::412930559924:policy/lesson-7-eks-jenkins-agent-ecr"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": [
        "iam:PutRolePermissionsBoundary",
        "iam:DeleteRolePermissionsBoundary"
      ],
      "Resource": "arn:aws:iam::412930559924:role/lesson-7-eks-jenkins-agent"
    },
    {
      "Effect": "Deny",
      "Action": [
        "iam:CreatePolicyVersion",
        "iam:SetDefaultPolicyVersion",
        "iam:DeletePolicyVersion",
        "iam:DeletePolicy"
      ],
      "Resource": "arn:aws:iam::412930559924:policy/lesson-7-eks-jenkins-agent-ecr"
    }
  ]
}
